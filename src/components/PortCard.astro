---
const { port } = Astro.props;

const date = port.date
  ? new Date(port.date).toLocaleDateString("es-AR")
  : "No releases";
---

<article class="rounded-2xl border p-5">
  <div class="flex items-start justify-between gap-4">
    <h2 class="text-xl font-semibold">
      {port.name}
    </h2>

    {port.isNew && (
      <span class="rounded-full bg-green-500 px-3 py-1 text-sm text-white">
        NEW
      </span>
    )}
  </div>

  <p class="mt-2 text-sm text-gray-500">
    {port.description}
  </p>

  {port.hasRelease && (
    <div class="mt-6">
      <p class="text-sm text-gray-500">
        Latest release
      </p>

      <p class="mt-1 font-medium">
        {port.tag}
      </p>

      <p class="mt-2 text-sm text-gray-500">
        {date}
      </p>

      {port.prerelease && (
        <span class="mt-3 inline-block text-xs text-orange-500">
          Prerelease
        </span>
      )}

      <a
        href={port.url}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-block underline"
      >
        View release
      </a>
    </div>
  )}
</article>
